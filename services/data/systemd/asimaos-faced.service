[Unit]
Description=Asima face sign-in and fingerprint or face approval of administrator tasks
Documentation=file:///usr/share/doc/asimaos/DESIGN.md

[Service]
Type=dbus
BusName=io.github.asimaos.Face1
ExecStart=/usr/lib/asimaos/asimaos-faced
# Faceprints: /var/lib/asimaos-face, root only.
StateDirectory=asimaos-face
StateDirectoryMode=0700
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
DeviceAllow=char-video4linux rw
DevicePolicy=closed
