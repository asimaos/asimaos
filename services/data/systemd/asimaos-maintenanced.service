[Unit]
Description=Asima Maintenance service (health, Secure Boot, disk keys, snapshots, backups, reset)
Documentation=file:///usr/share/doc/asimaos/DESIGN.md

[Service]
Type=dbus
BusName=io.github.asimaos.Maintenance1
ExecStart=/usr/lib/asimaos/asimaos-maintenanced
# The pool's top level (snapshots) is mounted only inside this service's own mount namespace.
PrivateMounts=yes
RuntimeDirectory=asimaos-maintenanced
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
