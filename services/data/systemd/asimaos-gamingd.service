[Unit]
Description=Asima Gaming service (handheld power limit, gaming CPU scheduler, RGB lighting)
Documentation=file:///usr/share/doc/asimaos/DESIGN.md

[Service]
Type=dbus
BusName=io.github.asimaos.Gaming1
ExecStart=/usr/lib/asimaos/asimaos-gamingd
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
