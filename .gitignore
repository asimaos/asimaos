# Build output and caches, including each build's own signing keys in build/keys.
# Keys never go into a repository (D25); they are kept in an encrypted archive.
/build/
keys/
*.pem
*.key
*.der
*.crt
*.p12

# OS images and update files: they live in build/out, never in git
*.iso
*.aosupd
*.aosupd.json
*.raw
*.qcow2
*.erofs
*.efi
*.img

# Generated by build.sh and apps/build.sh from builder/pacman.conf.in
builder/pacman.conf
# This computer's own build settings (faster mirrors): see docs/building.md
builder/local.conf

# Every app screen, rendered by "apps/build.sh screenshots" (a few are kept in docs/screenshots/)
apps/screenshots/

# Local copies for manual testing
test-images/

# Editors and Python
.vscode/
.idea/
*.swp
__pycache__/
