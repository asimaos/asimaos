#%PAM-1.0
# Asima OS: the login screen (plasma-login-manager, D11). Face sign-in first:
# pam_asimaos_face steps aside when no face is set up, when Asima Manager switched it off for
# sign-in, at the first sign-in after a start (the password then unlocks KDE Wallet too), and with
# a normal webcam, which only unlocks the screen (D37). Otherwise as Plasma ships it.

-auth       sufficient  pam_asimaos_face.so      use=login
auth        include     system-login
-auth       optional    pam_gnome_keyring.so
-auth       optional    pam_kwallet5.so

account     include     system-login

password    include     system-login
-password   optional    pam_gnome_keyring.so    use_authtok

session     optional    pam_keyinit.so          force revoke
session     include     system-login
-session    optional    pam_gnome_keyring.so    auto_start
-session    optional    pam_kwallet5.so         auto_start
