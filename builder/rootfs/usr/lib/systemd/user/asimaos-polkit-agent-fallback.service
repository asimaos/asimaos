[Unit]
Description=KDE's password dialog, when the Asima OS password dialog keeps failing
Documentation=file:///usr/lib/systemd/user/plasma-polkit-agent.service.d/asimaos.conf
PartOf=graphical-session.target

[Service]
ExecStart=/usr/lib/polkit-kde-authentication-agent-1
Slice=background.slice
TimeoutStopSec=5sec
Restart=on-failure
