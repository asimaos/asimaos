# Asima Builder container: rootless Arch build environment pinned to the archive snapshot.
FROM docker.io/archlinux/archlinux:base

COPY pacman.conf /etc/pacman.conf

# -Syuu syncs every package to the pinned snapshot (allows downgrades). build.sh mounts
# build/pkgcache as pacman's cache, so what is downloaded once is kept: a build cut off by the
# network goes on from there, and the stages use the same packages.
RUN pacman -Syuu --noconfirm \
        arch-install-scripts \
        erofs-utils \
        cryptsetup \
        btrfs-progs \
        dosfstools \
        mtools \
        systemd-ukify \
        libisoburn \
        librsvg \
        imagemagick
